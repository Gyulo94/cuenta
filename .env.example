CLIENT_PORT=<PORT>
SERVER_PORT=<PORT>

DEV_CLIENT_PORT=3000
DEV_SERVER_PORT=8000

DB_URL=jdbc:postgresql://<HOST>:<PORT>/<DB_NAME>
DB_USERNAME=dev
DB_PASSWORD=change-me

REDIS_HOST=<HOST>
REDIS_PORT=<PORT>
REDIS_PASSWORD=<PASSWORD>

APP_NAME=cuenta
APP_LOGO=<PUBLIC_LOGO_URL>
APP_ENV=dev
JWT_SECRET_KEY=<AT_LEAST_32_BYTE_SECRET>
JWT_REFRESH_SECRET_KEY=<AT_LEAST_32_BYTE_SECRET>
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
CLIENT_URL=http://localhost:3000

EMAIL_URL=https://<HOST>/email-server/
SENDER_EMAIL=<SENDER_EMAIL>
SENDER_PWD=<SENDER_PASSWORD>

SPRING_PROFILES_ACTIVE=prod

SERVER_IMAGE=<DOCKER_USERNAME>/cuenta-server:latest
CLIENT_IMAGE=<DOCKER_USERNAME>/cuenta-client:latest
